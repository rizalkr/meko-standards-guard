{
  "mcpServers": {
    "meko": {
      "command": "npx",
      "args": [
        "-y",
        "@yugabytedb/meko-mcp@latest",
        "--client",
        "claude-code",
        "--url",
        "https://mcp.mekodata.ai/mcp"
      ],
      "env": {
        "MEKO_API_TOKEN": "${MEKO_API_TOKEN}",
        "MEKO_DATAPACK": "payledger-standards-guard"
      }
    }
  }
}
