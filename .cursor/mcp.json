{
  "mcpServers": {
    "meko": {
      "url": "https://mcp.mekodata.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MEKO_API_TOKEN}",
        "User-Agent": "meko-mcp-installer/1.0"
      }
    },
    "standards-guard": {
      "command": "node",
      "args": [
        "packages/guard-cli/dist/bin.js",
        "mcp"
      ],
      "env": {
        "GUARD_MODE": "live",
        "MEKO_API_TOKEN": "${env:MEKO_API_TOKEN}",
        "MEKO_MCP_URL": "https://mcp.mekodata.ai/mcp",
        "MEKO_DATAPACK": "payledger-standards-guard"
      }
    }
  }
}
